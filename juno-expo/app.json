{
  "expo": {
    "name": "Juno",
    "slug": "juno",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.launch.juno"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.launch.juno",
      "versionCode": 122,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#D6FF3D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Juno uses your photos and videos so you can launch them as a post or a reel.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withQuotedBundleScript",
      "./plugins/withReleaseSigning"
    ],
    "scheme": "juno",
    "backgroundColor": "#D3E3CB",
    "description": "Every post is a market. Clock in daily on Solana, earn SKR, and back the posts you believe in."
  }
}
